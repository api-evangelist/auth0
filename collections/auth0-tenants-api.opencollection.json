{
  "opencollection": "1.0.0",
  "info": {
    "name": "Auth0 Authentication actions tenants API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "tenants",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Tenant Settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{auth0_domain}/tenants/settings",
            "params": [
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include or exclude (based on value provided for include_fields) in the result. Leave empty to retrieve all fields."
              },
              {
                "name": "include_fields",
                "value": "",
                "type": "query",
                "description": "Whether specified fields are to be included (true) or excluded (false)."
              }
            ]
          },
          "docs": "Retrieve tenant settings. A list of fields to include or exclude may also be specified."
        },
        {
          "info": {
            "name": "Update Tenant Settings",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{auth0_domain}/tenants/settings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update settings for a tenant."
        }
      ]
    }
  ],
  "bundled": true
}