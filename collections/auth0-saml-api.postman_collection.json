          "id": "ffb0bc0c-200e-4dc0-97a3-9615abe88519",
          "name": "Auth0 Use This Endpoint to Accept a SAML Request to Initiate a Login.",
          "request": {
            "name": "Auth0 Use This Endpoint to Accept a SAML Request to Initiate a Login.",
            "description": {
              "content": "Optionally, you can include a connection parameter to log in with a specific provider. If no connection is specified, the Auth0 Login Page will be shown.\nOptionally, SP-initiated login requests can include an organization parameter to authenticate users in the context of an organization. To learn more, see Organizations.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "samlp",
                ":client_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "connection",
                  "value": "<string>",
                  "description": "Connection to use during login."
                },
                {
                  "disabled": false,
                  "key": "organization",
                  "value": "<string>",
                  "description": "Organization ID, if authenticating in the context of an organization."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "client_id",
                  "description": "(Required) Client ID of your application."
                },
                {
                  "description": "Auth0 domain",
                  "type": "any",
                  "value": "{{auth0_domain}}",
                  "key": "auth0_domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
