          "name": "Upsert assertions for an authorization model ID",
          "request": {
            "name": "Upsert assertions for an authorization model ID",
            "description": {
              "content": "The WriteAssertions API will upsert new assertions for an authorization model id, or overwrite the existing ones. An assertion is an object that contains a tuple key, the expectation of whether a call to the Check API of that tuple key will return true or false, and optionally a list of contextual tuples.",
              "type": "text/plain"
            },
