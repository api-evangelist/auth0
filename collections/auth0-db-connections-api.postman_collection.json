            "description": {
              "content": "Send a change password email to the user's provided email address and connection. Optionally, you may provide an Organization ID to support Organization-specific variables in customized email templates and to include the organization_id and organization_name parameters in the Redirect To URL. Note: This endpoint only works for database connections.\n",
              "type": "text/plain"
            },
            "url": {
