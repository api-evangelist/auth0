            "name": "Get an Email Template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{auth0_domain}/email-templates/:templateName",
            "params": [
              {
                "name": "templateName",
                "value": "",
                "type": "path",
                "description": "Template name. Can be `verify_email`, `verify_email_by_code`, `reset_email`, `reset_email_by_code`, `welcome_email`, `blocked_account`, `stolen_credentials`, `enrollment_email`, `mfa_oob_code`, `user_invitation`, `async_approval`, `change_password` (legacy), or `password_reset` (legacy)."
              }
            ]
          },
          "docs": "Retrieve an email template by pre-defined name. These names are `verify_email`, `verify_email_by_code`, `reset_email`, `reset_email_by_code`, `welcome_email`, `blocked_account`, `stolen_credentials`, `enrollment_email`, `mfa_oob_code`, `user_invitation`, and `async_approval`. The names `change_password`, and `password_reset` are also supported for legacy scenarios."
        },
