{
  "opencollection": "1.0.0",
  "info": {
    "name": "Auth0 Authentication actions refresh-tokens API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "refresh-tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Refresh Tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{auth0_domain}/refresh-tokens",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "query",
                "description": "ID of the user whose refresh tokens to retrieve. Required."
              },
              {
                "name": "client_id",
                "value": "",
                "type": "query",
                "description": "Filter results by client ID. Only valid when user_id is provided."
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "An opaque cursor from which to start the selection (exclusive). Expires after 24 hours. Obtained from the next property of a previous response."
              },
              {
                "name": "take",
                "value": "",
                "type": "query",
                "description": "Number of results per page. Defaults to 50."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include or exclude (based on value provided for include_fields) in the result. Leave empty to retrieve all fields."
              },
              {
                "name": "include_fields",
                "value": "",
                "type": "query",
                "description": "Whether specified fields are to be included (true) or excluded (false)."
              }
            ]
          },
          "docs": "Retrieve a paginated list of refresh tokens for a specific user, with optional filtering by client ID. Results are sorted by credential_id ascending."
        },
        {
          "info": {
            "name": "Revoke Refresh Tokens",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{auth0_domain}/refresh-tokens/revoke",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Revoke refresh tokens in bulk by ID list, user, user+client, or client."
        },
        {
          "info": {
            "name": "Get a Refresh Token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{auth0_domain}/refresh-tokens/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID refresh token to retrieve"
              }
            ]
          },
          "docs": "Retrieve refresh token information."
        },
        {
          "info": {
            "name": "Update a Refresh Token",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{auth0_domain}/refresh-tokens/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the refresh token to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a refresh token by its ID."
        },
        {
          "info": {
            "name": "Delete a Refresh Token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{auth0_domain}/refresh-tokens/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the refresh token to delete."
              }
            ]
          },
          "docs": "Delete a refresh token by its ID."
        }
      ]
    }
  ],
  "bundled": true
}